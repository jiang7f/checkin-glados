# 推荐运行 uv run python checkin.py login，自动保存登录态。
# 也可以运行 update-cookie 从 macOS Chrome 导入。

# 可选：GLaDOS 登录窗口与签到 API 使用的 HTTP / mixed 代理端口
# CHECKIN_PROXY_URL=http://127.0.0.1:7890

# 可选：飞书群自定义机器人，留空则仅打印结果
# FEISHU_WEBHOOK=https://open.feishu.cn/open-apis/bot/v2/hook/replace-with-your-token
# 仅在机器人启用签名校验时填写
# FEISHU_SECRET=replace-with-your-signing-secret

# 手动登录方式一：完整 Cookie
# GLADOS_COOKIE='gld:sess=replace-with-session; gld:sess.sig=replace-with-signature'

# 手动登录方式二：新格式拆分配置，必须同时填写
# GLADOS_GLD_SESS=replace-with-session
# GLADOS_GLD_SESS_SIG=replace-with-signature

# 旧登录态兼容，不要将 gld:sess 的值填在这里
# GLADOS_KOA_SESS=replace-with-session
# GLADOS_KOA_SESS_SIG=replace-with-signature

# login 自动保存，通常无需手动填写
# GLADOS_USER_AGENT=your-browser-user-agent
